# SmartQueue AI Configuration
PORT=8080

# Primary API Key: OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Secondary / Fallback API Key: Google Gemini
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Google Apps Script URL (for sending confirmation emails & Excel sheets to doctors)
APPS_SCRIPT_URL=your_deployed_apps_script_web_app_url_here

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

